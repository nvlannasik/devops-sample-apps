# Local development. Copy to .env; docker-compose reads none of it — it is for `npm run dev`.
# Discrete DB_* variables, the same names devops-ai-agent reads.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=sample
DB_PASSWORD=sample
DB_NAME=sample_app
# disable | require | verify-ca | verify-full. An unknown value fails at boot.
DB_SSL_MODE=disable
# Database-backed tests are skipped unless this is set.
TEST_DATABASE_URL=postgres://sample:sample@127.0.0.1:5432/sample_app
LOG_LEVEL=debug
SERVICE_VERSION=dev

# /api on checkout-gateway. One value, read by the gateway (enforces) and the storefront
# (presents). Unset leaves /api open, with a warning at boot.
GATEWAY_AUTH_TOKEN=local-gateway-token

# Load generator control page. Unset LOADGEN_UI_PASSWORD and it serves 503 rather than an
# unauthenticated Start button. Cookie must not be Secure over plain HTTP — the browser drops it
# in silence and the login form just reappears.
LOADGEN_UI_PASSWORD=local-demo
LOADGEN_UI_COOKIE_SECURE=false
# Shows the "Load generator" button in the storefront header. A browser follows it.
LOADGEN_UI_URL=http://localhost:8090
