{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    // Explicit: without this, only the services that depend on @types/pg get Node's
    // globals (fetch, process, setTimeout), pulled in transitively by accident.
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
